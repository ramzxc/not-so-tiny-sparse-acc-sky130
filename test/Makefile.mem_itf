SIM = verilator
TOPLEVEL_LANG = verilog
TOPLEVEL = mem_itf
COCOTB_TEST_MODULES = test_mem_itf
ROOT := $(abspath $(CURDIR)/..)
BUILD ?= /tmp/acc-mem-itf
SIM_BUILD = $(BUILD)/sim
COCOTB_RESULTS_FILE = $(BUILD)/results.xml
VERILOG_SOURCES = $(ROOT)/src/rtl/shared_sram.sv $(ROOT)/src/rtl/mem_itf.sv
VERILOG_SOURCES += $(ROOT)/memory/openram/generated/tt_sram_1rw_64x128_buffered_sky130/tt_sram_1rw_64x128_buffered_sky130.v
COMPILE_ARGS += -I$(ROOT)/src/rtl -I$(ROOT)/src/rtl -Wno-fatal --timing --timescale-override 1ns/1ps
include $(shell cocotb-config --makefiles)/Makefile.sim

SIM = verilator
TOPLEVEL_LANG = verilog
TOPLEVEL = dma_ctrl
COCOTB_TEST_MODULES = test_dma
ROOT := $(abspath $(CURDIR)/..)
BUILD ?= /tmp/acc-dma
SIM_BUILD = $(BUILD)/sim
COCOTB_RESULTS_FILE = $(BUILD)/results.xml
VERILOG_SOURCES = $(ROOT)/src/legacy/core/dma_ctrl.v
COMPILE_ARGS += -I$(ROOT)/src/legacy/core -Wno-fatal --timing --timescale-override 1ns/1ps
include $(shell cocotb-config --makefiles)/Makefile.sim

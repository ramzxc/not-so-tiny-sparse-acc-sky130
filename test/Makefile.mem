SIM = verilator
TOPLEVEL_LANG = verilog
TOPLEVEL = mem_ctrl
COCOTB_TEST_MODULES = test_mem_ctrl
SRAM_BYTES ?= 1024
SIM_BUILD = sim_build/mem_$(SRAM_BYTES)
SRAM_BUFFER_CELLS ?= 0
VERILOG_SOURCES = $(CURDIR)/../src/tpu_pkg.sv $(CURDIR)/../src/shared_sram.sv $(CURDIR)/../src/mem_ctrl.sv
VERILOG_SOURCES += $(wildcard $(CURDIR)/../memory/openram/generated/*/tt_sram*.v)
COMPILE_ARGS += -DACC_SRAM_BYTES=$(SRAM_BYTES) -Wno-fatal --timing --timescale-override 1ns/1ps
ifeq ($(SRAM_BUFFER_CELLS),1)
SIM_BUILD = sim_build/mem_$(SRAM_BYTES)_buffered
COMPILE_ARGS += -DSYNTHESIS -DFUNCTIONAL -DUNIT_DELAY=\#1
VERILOG_SOURCES += $(PDK_ROOT)/sky130A/libs.ref/sky130_fd_sc_hd/verilog/primitives.v
VERILOG_SOURCES += $(PDK_ROOT)/sky130A/libs.ref/sky130_fd_sc_hd/verilog/sky130_fd_sc_hd.v
endif
export SRAM_BYTES
COCOTB_RESULTS_FILE = $(CURDIR)/$(SIM_BUILD)/results.xml
include $(shell cocotb-config --makefiles)/Makefile.sim

# Pin-level checks of the netlist produced by the current Tiny Tapeout GDS run.
.DEFAULT_GOAL := sim
SIM ?= icarus
TOPLEVEL_LANG = verilog
TOPLEVEL = tb_gate_psram
COCOTB_TEST_MODULES = test_gate_psram
ROOT := $(abspath $(CURDIR)/..)
BUILD ?= /tmp/acc-gate-psram
SIM_BUILD = $(BUILD)/sim
GATE_NETLIST ?= $(CURDIR)/gate_level_netlist.v
PDK ?= sky130A
PDK_MODELS = $(PDK_ROOT)/$(PDK)/libs.ref/sky130_fd_sc_hd/verilog
# Nonzero sequential-cell clock-to-Q avoids delta-cycle races with the
# SRAM model sampling inputs through a zero-delay routed clock tree. No SDF.
COMPILE_ARGS += -DFUNCTIONAL -DUSE_POWER_PINS -g2012 -DUNIT_DELAY=\#1
VERILOG_SOURCES = $(PDK_MODELS)/primitives.v $(PDK_MODELS)/sky130_fd_sc_hd.v $(GATE_NETLIST)
# The wrapper netlist retains this hard macro instance. Use its powered circuit.
VERILOG_SOURCES += $(ROOT)/macro/acc_hard_macro/acc_hard_macro.v
VERILOG_SOURCES += $(ROOT)/memory/openram/generated/tt_sram_1rw_64x128_buffered_sky130/tt_sram_1rw_64x128_buffered_sky130.v
VERILOG_SOURCES += $(CURDIR)/tb_gate_psram.sv $(CURDIR)/qspi_psram_model.sv
export STREAM_FIXTURE=$(BUILD)/psram.hex
CUSTOM_SIM_DEPS += $(BUILD)/psram.hex
COCOTB_PLUSARGS += +FIXTURE=$(BUILD)/psram.hex
$(BUILD)/psram.hex: $(CURDIR)/prepare_psram_fixture.py $(CURDIR)/fp8_reference.py
	mkdir -p $(BUILD)
	python3 $(CURDIR)/prepare_psram_fixture.py $@
include $(shell cocotb-config --makefiles)/Makefile.sim

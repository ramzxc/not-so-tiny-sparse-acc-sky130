SIM = verilator
TOPLEVEL_LANG = verilog
TOPLEVEL = psram_arbiter
COCOTB_TEST_MODULES = test_psram_arbiter
ROOT := $(abspath $(CURDIR)/..)
BUILD ?= /tmp/acc-psram-arbiter
SIM_BUILD = $(BUILD)/sim
COCOTB_RESULTS_FILE = $(BUILD)/results.xml
VERILOG_SOURCES = $(ROOT)/src/rtl/psram_arbiter.v
export FETCH_WRITES ?= 0
COMPILE_ARGS += -GFETCH_WRITES=$(FETCH_WRITES) -Wno-fatal --timing --timescale-override 1ns/1ps
include $(shell cocotb-config --makefiles)/Makefile.sim

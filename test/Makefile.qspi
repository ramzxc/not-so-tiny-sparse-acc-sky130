SIM = verilator
TOPLEVEL_LANG = verilog
TOPLEVEL = tb_qspi_burst
COCOTB_TEST_MODULES = test_qspi_burst
ROOT := $(abspath $(CURDIR)/..)
BUILD ?= /tmp/acc-qspi-burst
SIM_BUILD = $(BUILD)/sim
COCOTB_RESULTS_FILE = $(BUILD)/results.xml
VERILOG_SOURCES = $(ROOT)/src/legacy/qspi_ctrl.v $(CURDIR)/rtl/models/qspi_nor_model.sv $(CURDIR)/rtl/tb/tb_qspi_burst.sv
COMPILE_ARGS += -I$(ROOT)/src/legacy -Wno-fatal --timing --timescale-override 1ns/1ps
include $(shell cocotb-config --makefiles)/Makefile.sim

SIM = verilator
TOPLEVEL_LANG = verilog
TOPLEVEL = exec_unit
COCOTB_TEST_MODULES = test_fp16_exec
ROOT := $(abspath $(CURDIR)/..)
BUILD ?= /tmp/acc-fp16-exec
SIM_BUILD = $(BUILD)/sim
COCOTB_RESULTS_FILE = $(BUILD)/results.xml
VERILOG_SOURCES = $(ROOT)/src/legacy/core/exec_unit.sv
COMPILE_ARGS += -I$(ROOT)/src/legacy -I$(ROOT)/src/legacy/core -Wno-fatal --timing --timescale-override 1ns/1ps
include $(shell cocotb-config --makefiles)/Makefile.sim

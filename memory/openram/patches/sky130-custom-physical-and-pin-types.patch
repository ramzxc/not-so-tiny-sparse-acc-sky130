diff --git a/compiler/modules/pinv_tapped.py b/compiler/modules/pinv_tapped.py
new file mode 100644
index 0000000..2095c11
--- /dev/null
+++ b/compiler/modules/pinv_tapped.py
@@ -0,0 +1,59 @@
+"""Parallel, individually tapped inverter slices for SKY130 latch-up spacing."""
+from math import ceil
+from openram import OPTS
+from openram.base import vector
+from openram.sram_factory import factory
+from openram.modules.pinv import pinv
+
+class pinv_tapped(pinv):
+    def __init__(self, name, size=1, **kwargs):
+        self.slice_count=max(1,ceil(size/24))
+        super().__init__(name,size=size,**kwargs)
+
+    def create_netlist(self):
+        if self.slice_count==1:
+            return super().create_netlist()
+        self.add_pins()
+        self.slice=factory.create(module_type='pinv_leaf',size=self.size/self.slice_count,
+                                  beta=self.beta,height=self.height,add_wells=True)
+        self.parts=[]
+        for i in range(self.slice_count):
+            self.parts.append(self.add_inst(name=f'slice{i}',mod=self.slice))
+            self.connect_inst(['A','Z','vdd','gnd'])
+        self.nmos_width=self.slice.nmos_width
+        self.pmos_width=self.slice.pmos_width
+        self.tx_mults=self.slice.tx_mults*self.slice_count
+
+    def create_layout(self):
+        if self.slice_count==1:
+            return super().create_layout()
+        for i,inst in enumerate(self.parts):inst.place(vector(i*self.slice.width,0))
+        self.width=self.slice.width*self.slice_count
+        self.height=self.slice.height
+        for net,metal,y in [('A','m2',0.9),('Z','m3',self.height-0.9)]:
+            points=[]
+            for inst in self.parts:
+                pin=inst.get_pin(net);c=pin.center();dst=vector(c.x,y)
+                self.add_via_stack_center(from_layer=pin.layer,to_layer=metal,offset=c)
+                self.add_path(metal,[c,dst])
+                width=2*getattr(self,metal+'_width')
+                self.add_rect_center(metal,dst,width=width,height=width)
+                points.append(dst)
+            self.add_path(metal,[points[0],points[-1]])
+        self.copy_layout_pin(self.parts[0],'A')
+        self.copy_layout_pin(self.parts[-1],'Z')
+        for inst in self.parts:
+            self.copy_layout_pin(inst,'vdd');self.copy_layout_pin(inst,'gnd')
+        self.add_boundary()
+
+    def get_on_resistance(self):
+        if self.slice_count==1:return super().get_on_resistance()
+        return self.slice.get_on_resistance()/self.slice_count
+
+    def get_input_capacitance(self):
+        if self.slice_count==1:return super().get_input_capacitance()
+        return self.slice.get_input_capacitance()*self.slice_count
+
+    def get_intrinsic_capacitance(self):
+        if self.slice_count==1:return super().get_intrinsic_capacitance()
+        return self.slice.get_intrinsic_capacitance()*self.slice_count
